{
  "expo": {
    "name": "Golf Coach",
    "slug": "golf-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cocopoppyhead.golfcoach",
      "infoPlist": {
        "NSCameraUsageDescription": "Golf Coach uses the camera to record your swing.",
        "NSMicrophoneUsageDescription": "Video recording includes sound from the microphone.",
        "NSPhotoLibraryUsageDescription": "Golf Coach opens swing videos and scorecard photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "Golf Coach can save your annotated swing videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cocopoppyhead.golfcoach",
      "adaptiveIcon": {
        "backgroundColor": "#0b1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Golf Coach connects to your Bushnell rangefinder to read distances."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b1120"
        }
      ]
    ],
    "scheme": "golfcoach",
    "backgroundColor": "#0b1120"
  }
}