{
  "expo": {
    "name": "ohsolo",
    "slug": "golf-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cocopoppyhead.golfcoach",
      "infoPlist": {
        "NSCameraUsageDescription": "ohsolo uses the camera to record your swing.",
        "NSMicrophoneUsageDescription": "Video recording includes sound from the microphone.",
        "NSPhotoLibraryUsageDescription": "ohsolo opens swing videos and scorecard photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "ohsolo can save your annotated swing videos.",
        "NSLocationWhenInUseUsageDescription": "ohsolo uses your location for the weather (temperature and wind) when you log a shot, and to find courses near you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cocopoppyhead.golfcoach",
      "adaptiveIcon": {
        "backgroundColor": "#0b1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "ohsolo connects to your Bushnell rangefinder to read distances."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b1120"
        }
      ],
      "./plugins/withCaptureQueries.js"
    ],
    "scheme": "golfcoach",
    "backgroundColor": "#0b1120",
    "extra": {
      "eas": {
        "projectId": "30ebbb6e-b46b-465c-8dcd-6b568c0b8cef"
      }
    },
    "owner": "conor21m"
  }
}
